# 文案：优先 Kimi Code（Hermes 的 KIMI_API_KEY）。不要把真实 Key 提交进 git。
# NOTE_LLM_KEY=
# NOTE_LLM_BASE_URL=https://api.kimi.com/coding/v1
# NOTE_LLM_MODEL=k3
# KIMI_API_KEY=

# OpenAI 备选（默认模型 gpt-6-astra）
# OPENAI_API_KEY=
# NOTE_LLM_BASE_URL=https://api.openai.com/v1
# NOTE_LLM_MODEL=gpt-6-astra

# 出图：配一个即可。都不配则用公开演示源（慢、质量不稳）
# 本机 Hermes 出图桥（Mac 常开，scripts/install-hermes-image-bridge.sh）
# NOTE_IMAGE_PROVIDER=hermes
# HERMES_IMAGE_URL=http://192.168.31.x:8879
# HERMES_IMAGE_TOKEN=
# FAL_KEY=
# SILICONFLOW_API_KEY=

# 新增长工作台：GPT 接待单独配置，不自动使用 Kimi / Moonshot / DeepSeek
# GROWTH_LLM_KEY=                 # 留空时使用 OPENAI_API_KEY
# 可选：仅默认空间复用本机已有 Hermes → Codex 登录（默认关闭）
# HERMES_CODEX_ENABLED=1
# HERMES_CODEX_ROOT=/absolute/path/to/hermes-agent
# HERMES_CODEX_PYTHON=/absolute/path/to/python3
# 启用后还需在「模型设置」选择该连接；不复制凭据、不刷新登录、不启动 Agent 工具。
# GROWTH_LLM_MODEL=gpt-6-astra
# GROWTH_LLM_BASE_URL=https://api.openai.com/v1
# HOST=127.0.0.1                 # 本机部署建议只监听本地；对外使用 HTTPS 反向代理
# DISABLE_COLLECT=1              # 隔离调试时禁止定时拉取平台数据
# GROWTH_TEAM_TOKENS=[]          # 每项 {"token":"至少24字符独立令牌","name":"接待员","role":"operator","memberId":"owner"}
# 启用团队令牌必须设置 AUTH_TOKEN。角色仅 operator / viewer，管理员使用 AUTH_TOKEN。

# 新版优先在「模型设置」配置：按工作空间加密保存，实时生效，无需改此文件。
# 自定义 OpenAI 兼容网关必须先显式允许主机（逗号分隔；不是完整 URL）。
# 默认允许 api.openai.com；默认空间已配置的 GROWTH_LLM_BASE_URL 主机也被允许。
# GROWTH_LLM_ALLOWED_HOSTS=api.my-trusted-gateway.example
# GROWTH_EMBEDDINGS_ENABLED=0     # 也可在模型设置中启用；知识库手动建索引后生效
# GROWTH_EMBEDDING_MODEL=text-embedding-3-small
# 本地中文向量：在模型设置选择「本地中文向量 + 关键词」，无需 API 密钥。
# 模型下载缓存与业务数据库分离；首次建立索引下载固定版本 BGE-small-zh-v1.5，之后可离线计算。
# GROWTH_EMBEDDING_CACHE=/absolute/path/to/model-cache
# SESSION_COOKIE_SECURE=1        # HTTPS 生产部署必须开启；本机 HTTP 调试保持未设置
# 备份数据库时同时备份数据目录内 .model-encryption-key；不能提交到 Git。
